{
  "extensionId": "gpui.net.editor",
  "schemaVersion": 6,
  "components": [
    {
      "kind": "editor",
      "configuration": {
        "encoding": "lines",
        "fields": [
          { "name": "flags", "type": "flags" },
          { "name": "language", "type": "string" },
          { "name": "changed_event", "type": "event" },
          { "name": "command_rejected_event", "type": "event" },
          { "name": "line_number_width", "type": "f32" }
        ]
      },
      "flags": {
        "disabled": 0,
        "read_only": 1,
        "line_numbers": 2,
        "folding": 3,
        "show_whitespace": 4
      },
      "commands": {
        "bootstrap": {
          "id": 1,
          "payload": "utf8-document",
          "revision": "none"
        },
        "focus": {
          "id": 2,
          "payload": "none",
          "revision": "none"
        },
        "set_selection": {
          "id": 3,
          "payload": "start-u64-le;end-u64-le",
          "revision": "expected"
        },
        "replace_document": {
          "id": 4,
          "payload": "utf8-document",
          "revision": "expected"
        },
        "apply_edit": {
          "id": 5,
          "payload": "start-u64-le;deleted-u64-le;inserted-utf8",
          "revision": "expected"
        }
      },
      "events": {
        "changed": {
          "id": 1,
          "flags": "origin",
          "payload": "base-revision-u64-le; edit-count-u32-le; repeated(start-u64-le,deleted-u64-le,inserted-length-u64-le,inserted-utf8)",
          "revision": "result"
        },
        "command_rejected": {
          "id": 2,
          "flags": "reason",
          "payload": "command-u16-le;reserved-u16-zero;expected-revision-u64-le",
          "revision": "current"
        }
      }
    }
  ]
}
