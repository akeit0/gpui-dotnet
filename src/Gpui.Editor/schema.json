{
  "extensionId": "gpui.net.editor",
  "schemaVersion": 3,
  "components": [
    {
      "kind": "editor",
      "configuration": "flags-u32-decimal\\nlanguage\\nchanged-event-token-u64-decimal",
      "flags": {
        "disabled": 0,
        "read_only": 1,
        "line_numbers": 2,
        "folding": 3,
        "show_whitespace": 4
      },
      "commands": {
        "bootstrap": {
          "id": 1,
          "payload": "utf8-document",
          "revision": "none"
        }
      },
      "events": {
        "changed": {
          "id": 1,
          "flags": "origin",
          "payload": "base-revision-u64-le; edit-count-u32-le; repeated(start-u64-le,deleted-u64-le,inserted-length-u64-le,inserted-utf8)",
          "revision": "result"
        }
      }
    }
  ]
}
