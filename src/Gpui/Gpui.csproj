<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gpui</RootNamespace>
        <AssemblyName>Gpui</AssemblyName>
        <PackageId>GPUI.NET</PackageId>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Description>GPUI bindings for .NET.</Description>
        <PackageTags>gpui;gui;dotnet;csharp;rust</PackageTags>
        <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
        <RepositoryRoot>$(MSBuildThisFileDirectory)../..</RepositoryRoot>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Gpui.Core/Gpui.Core.csproj" />
        <ProjectReference Include="../Gpui.Native/Gpui.Native.csproj" />
        <ProjectReference
            Include="$(RepositoryRoot)/src/Gpui.Generators/Gpui.Generators.csproj"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(RepositoryRoot)/NUGET_README.md" Pack="true" PackagePath="\" />
        <None Include="$(RepositoryRoot)/NOTICE" Pack="true" PackagePath="\" />
        <None Include="$(RepositoryRoot)/docs/EXTENSIONS.md" Pack="true" PackagePath="docs" />
        <None
            Include="$(RepositoryRoot)/src/Gpui.Generators/bin/$(Configuration)/netstandard2.0/Gpui.Generators.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
        />
    </ItemGroup>
</Project>
