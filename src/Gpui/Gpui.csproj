<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gpui</RootNamespace>
        <AssemblyName>Gpui</AssemblyName>
        <PackageId>Gpui</PackageId>
        <Version>0.4.0</Version>
        <Authors>GPUI.NET contributors</Authors>
        <Description>Allocation-conscious .NET frontend for GPUI with multi-window managed Views, retained native controls, virtualized List batching, and source-generated event/data-source dispatch.</Description>
        <PackageTags>gpui;gui;dotnet;csharp;rust</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- <GenerateDocumentationFile>true</GenerateDocumentationFile> -->

        <NativeCargoProfile Condition="'$(Configuration)' == 'Release'">release</NativeCargoProfile>
        <NativeCargoProfile Condition="'$(NativeCargoProfile)' == ''">debug</NativeCargoProfile>
        <NativeCrateDir>$(MSBuildThisFileDirectory)..\..\crates\gpui-dotnet</NativeCrateDir>
        <RepositoryRoot>$(MSBuildThisFileDirectory)..\..</RepositoryRoot>
        <NativeBuildScript>$(RepositoryRoot)\eng\build-native.ps1</NativeBuildScript>
        <NativeBuildCommand Condition="$([MSBuild]::IsOSPlatform('Windows'))"
            >powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(NativeBuildScript)&quot; -ManifestPath &quot;$(NativeCrateDir)\Cargo.toml&quot; -Configuration $(NativeCargoProfile)</NativeBuildCommand>
        <NativeBuildCommand Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
            >pwsh -NoProfile -File &quot;$(NativeBuildScript)&quot; -ManifestPath &quot;$(NativeCrateDir)\Cargo.toml&quot; -Configuration $(NativeCargoProfile)</NativeBuildCommand>
        <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))"
            >gpui_dotnet.dll</NativeLibraryName>
        <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('Linux'))"
            >libgpui_dotnet.so</NativeLibraryName>
        <NativeLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))"
            >libgpui_dotnet.dylib</NativeLibraryName>
        <NativeLibraryPath>$(NativeCrateDir)\target\$(NativeCargoProfile)\$(NativeLibraryName)</NativeLibraryPath>
        <NativeBuildStamp>$(NativeCrateDir)\target\$(NativeCargoProfile)\.gpui-msbuild.stamp</NativeBuildStamp>
        <NativeBindingsPath>$(MSBuildThisFileDirectory)Interop\NativeMethods.g.cs</NativeBindingsPath>
        <BindingsGeneratorProject>$(RepositoryRoot)\tools\Gpui.Bindings.Generator\Gpui.Bindings.Generator.csproj</BindingsGeneratorProject>
        <ViewGeneratorProject>$(RepositoryRoot)\src\Gpui.Generators\Gpui.Generators.csproj</ViewGeneratorProject>
        <ViewGeneratorAssembly>$(RepositoryRoot)\src\Gpui.Generators\bin\$(Configuration)\netstandard2.0\Gpui.Generators.dll</ViewGeneratorAssembly>
        <BuildGpuiNative Condition="'$(BuildGpuiNative)' == ''">true</BuildGpuiNative>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Utf8StringInterpolation" Version="1.3.2" />
        <ProjectReference
            Include="$(ViewGeneratorProject)"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
        />
        <InternalsVisibleTo Include="Gpui.Tests" />
    </ItemGroup>

    <ItemGroup>
        <_GpuiNativeInput Include="$(NativeCrateDir)\src\**\*.rs" />
        <_GpuiNativeInput Include="$(NativeCrateDir)\Cargo.toml" />
        <_GpuiNativeInput Include="$(NativeCrateDir)\Cargo.lock" />
        <_GpuiNativeInput Include="$(NativeCrateDir)\build.rs" />
        <_GpuiNativeInput Include="$(NativeBuildScript)" />
        <_GpuiBindingInput Include="$(NativeCrateDir)\src\abi.rs" />
        <_GpuiBindingInput Include="$(NativeCrateDir)\src\lib.rs" />
        <_GpuiBindingInput Include="$(NativeCrateDir)\Cargo.toml" />
        <_GpuiBindingInput Include="$(NativeCrateDir)\Cargo.lock" />
        <_GpuiBindingInput Include="$(NativeCrateDir)\build.rs" />

        <None
            Include="$(NativeLibraryPath)"
            Condition="'$(BuildGpuiNative)' == 'true'"
            Link="$(NativeLibraryName)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            Pack="false"
        />

        <None Include="$(RepositoryRoot)\README.md" Pack="true" PackagePath="\" />
        <None Include="$(RepositoryRoot)\NOTICE" Pack="true" PackagePath="\" />
        <None
            Include="$(ViewGeneratorAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
        />

        <None
            Include="$(RepositoryRoot)\artifacts\native\win-x64\gpui_dotnet.dll"
            Condition="Exists('$(RepositoryRoot)\artifacts\native\win-x64\gpui_dotnet.dll')"
            Pack="true"
            PackagePath="runtimes/win-x64/native"
        />
        <None
            Include="$(RepositoryRoot)\artifacts\native\linux-x64\libgpui_dotnet.so"
            Condition="Exists('$(RepositoryRoot)\artifacts\native\linux-x64\libgpui_dotnet.so')"
            Pack="true"
            PackagePath="runtimes/linux-x64/native"
        />
        <None
            Include="$(RepositoryRoot)\artifacts\native\osx-x64\libgpui_dotnet.dylib"
            Condition="Exists('$(RepositoryRoot)\artifacts\native\osx-x64\libgpui_dotnet.dylib')"
            Pack="true"
            PackagePath="runtimes/osx-x64/native"
        />
        <None
            Include="$(RepositoryRoot)\artifacts\native\osx-arm64\libgpui_dotnet.dylib"
            Condition="Exists('$(RepositoryRoot)\artifacts\native\osx-arm64\libgpui_dotnet.dylib')"
            Pack="true"
            PackagePath="runtimes/osx-arm64/native"
        />
    </ItemGroup>

    <Target
        Name="GenerateGpuiSemanticBindings"
        BeforeTargets="PrepareForBuild"
        Condition="'$(DesignTimeBuild)' != 'true'"
    >
        <Exec Command="dotnet run --project &quot;$(BindingsGeneratorProject)&quot; --configuration $(Configuration) --no-launch-profile -- generate --root &quot;$(RepositoryRoot)&quot;" />
    </Target>

    <Target Name="VerifyGpuiSemanticBindings" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="dotnet run --project &quot;$(BindingsGeneratorProject)&quot; --configuration $(Configuration) --no-launch-profile -- verify --root &quot;$(RepositoryRoot)&quot;" />
    </Target>

    <Target
        Name="GenerateGpuiBindings"
        Condition="'$(BuildGpuiNative)' == 'true'"
        Inputs="@(_GpuiBindingInput)"
        Outputs="$(NativeBindingsPath)"
    >
        <Exec Command="$(NativeBuildCommand)" />
        <Touch Files="$(NativeBuildStamp)" AlwaysCreate="true" />
    </Target>

    <Target
        Name="BuildGpuiNative"
        BeforeTargets="CoreCompile"
        DependsOnTargets="GenerateGpuiBindings"
        Condition="'$(BuildGpuiNative)' == 'true'"
        Inputs="@(_GpuiNativeInput)"
        Outputs="$(NativeBuildStamp)"
    >
        <Exec Command="$(NativeBuildCommand)" />
        <Touch Files="$(NativeBuildStamp)" AlwaysCreate="true" />
    </Target>
</Project>
