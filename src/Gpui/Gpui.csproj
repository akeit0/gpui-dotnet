<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gpui</RootNamespace>
        <AssemblyName>Gpui</AssemblyName>
        <PackageId>Gpui</PackageId>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Version>0.4.0</Version>
        <Authors>GPUI.NET contributors</Authors>
        <Description>Allocation-conscious .NET frontend for GPUI with multi-window managed Views, retained native controls, virtualized List batching, and view-bound event/data-source dispatch.</Description>
        <PackageTags>gpui;gui;dotnet;csharp;rust</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryRoot>$(MSBuildThisFileDirectory)../..</RepositoryRoot>
        <AbiAssemblyPath>$(MSBuildThisFileDirectory)../Gpui.Abi/bin/$(Configuration)/$(TargetFramework)/Gpui.Abi.dll</AbiAssemblyPath>
        <CoreAssemblyPath>$(MSBuildThisFileDirectory)../Gpui.Core/bin/$(Configuration)/$(TargetFramework)/Gpui.Core.dll</CoreAssemblyPath>
        <RuntimeAssemblyPath>$(MSBuildThisFileDirectory)../Gpui.Runtime/bin/$(Configuration)/$(TargetFramework)/Gpui.Runtime.dll</RuntimeAssemblyPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TypeForwarders.cs" />
        <PackageReference Include="Utf8StringInterpolation" Version="1.3.2" />
        <ProjectReference Include="../Gpui.Abi/Gpui.Abi.csproj" PrivateAssets="all" />
        <ProjectReference Include="../Gpui.Core/Gpui.Core.csproj" PrivateAssets="all" />
        <ProjectReference Include="../Gpui.Runtime/Gpui.Runtime.csproj" PrivateAssets="all" />
        <ProjectReference
            Include="$(RepositoryRoot)/src/Gpui.Generators/Gpui.Generators.csproj"
            ReferenceOutputAssembly="false"
            PrivateAssets="all"
        />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(RepositoryRoot)/README.md" Pack="true" PackagePath="\" />
        <None Include="$(RepositoryRoot)/NOTICE" Pack="true" PackagePath="\" />
        <None Include="$(AbiAssemblyPath)" Pack="true" PackagePath="lib/$(TargetFramework)" Visible="false" />
        <None Include="$(CoreAssemblyPath)" Pack="true" PackagePath="lib/$(TargetFramework)" Visible="false" />
        <None Include="$(RuntimeAssemblyPath)" Pack="true" PackagePath="lib/$(TargetFramework)" Visible="false" />
        <None
            Include="$(RepositoryRoot)/src/Gpui.Generators/bin/$(Configuration)/netstandard2.0/Gpui.Generators.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false"
        />

        <None
            Include="$(RepositoryRoot)/artifacts/native/win-x64/gpui_dotnet.dll"
            Condition="Exists('$(RepositoryRoot)/artifacts/native/win-x64/gpui_dotnet.dll')"
            Pack="true"
            PackagePath="runtimes/win-x64/native"
        />
        <None
            Include="$(RepositoryRoot)/artifacts/native/linux-x64/libgpui_dotnet.so"
            Condition="Exists('$(RepositoryRoot)/artifacts/native/linux-x64/libgpui_dotnet.so')"
            Pack="true"
            PackagePath="runtimes/linux-x64/native"
        />
        <None
            Include="$(RepositoryRoot)/artifacts/native/osx-x64/libgpui_dotnet.dylib"
            Condition="Exists('$(RepositoryRoot)/artifacts/native/osx-x64/libgpui_dotnet.dylib')"
            Pack="true"
            PackagePath="runtimes/osx-x64/native"
        />
        <None
            Include="$(RepositoryRoot)/artifacts/native/osx-arm64/libgpui_dotnet.dylib"
            Condition="Exists('$(RepositoryRoot)/artifacts/native/osx-arm64/libgpui_dotnet.dylib')"
            Pack="true"
            PackagePath="runtimes/osx-arm64/native"
        />
    </ItemGroup>

    <Target Name="ValidateGpuiImplementationAssemblies" BeforeTargets="GenerateNuspec">
        <Error
            Condition="!Exists('$(AbiAssemblyPath)')"
            Text="Gpui.Abi.dll was not built at $(AbiAssemblyPath)."
        />
        <Error
            Condition="!Exists('$(CoreAssemblyPath)')"
            Text="Gpui.Core.dll was not built at $(CoreAssemblyPath)."
        />
        <Error
            Condition="!Exists('$(RuntimeAssemblyPath)')"
            Text="Gpui.Runtime.dll was not built at $(RuntimeAssemblyPath)."
        />
    </Target>
</Project>
