<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Gpui</RootNamespace>
        <AssemblyName>Gpui.Native.linux-x64</AssemblyName>
        <PackageId>GPUI.NET.Native.linux-x64</PackageId>
        <Description>Native GPUI bindings for linux-x64.</Description>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
        <RepositoryRoot>$(MSBuildThisFileDirectory)../..</RepositoryRoot>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="**" />
        <Compile Remove="**" />
        <EmbeddedResource Remove="**" />
        <None Include="$(RepositoryRoot)/README.md" Pack="true" PackagePath="\" />
        <None
            Include="$(RepositoryRoot)/artifacts/native/linux-x64/libgpui_dotnet.so"
            Condition="Exists('$(RepositoryRoot)/artifacts/native/linux-x64/libgpui_dotnet.so')"
            Pack="true"
            PackagePath="runtimes/linux-x64/native"
        />
    </ItemGroup>
</Project>
