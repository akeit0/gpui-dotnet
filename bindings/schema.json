        { "id": 12, "name": "reset", "csharp": "ListReset", "doc": "Rebuilds native state at a new item count." },
        { "id": 13, "name": "refresh", "csharp": "ListRefresh", "doc": "Invalidates measurements for an item range." }
      ]
