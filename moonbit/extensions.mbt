///| Version/hash are generated by the extension schema generator, not negotiated by name alone.
pub(all) struct Extension {
  id : String
  component : String
  version : UInt
  schema_hash : UInt64
}


///|
fn hex16(value : UInt64) -> String {
  let digits = b"0123456789ABCDEF"
  let buffer = FixedArray::make(16, b'0')
  for i = 0; i < 16; i = i + 1 {
    buffer[i] = digits[((value >> ((15 - i) * 4)) & 15UL).to_int()]
  }
  @utf8.decode_lossy(Bytes::from_array(buffer[:])[:])
}

///| Package-specific builders own their configuration codec; the core owns the six-field envelope.
pub fn Frame::extension(self : Frame, extension : Extension, key : String, configuration : String) -> Element {
  let fields = [encode_text(extension.id), encode_text(extension.component), encode_text(key),
    encode_text(extension.version.to_string()), encode_text(hex16(extension.schema_hash)), encode_text(configuration)]
  let mut length = 5
  for field in fields {
    if has_nul(field) || field.length() > 16 * 1024 * 1024 - length {
      self.fail("Invalid extension field or configuration size")
      return { frame: self, index: -1 }
    }
    length = length + field.length()
  }
  if extension.version == 0U || extension.schema_hash == 0UL || !valid_key(fields[2]) {
    self.fail("Invalid extension identity/version/hash/key")
    return { frame: self, index: -1 }
  }
  let buffer = FixedArray::make(length, b'\x00')
  let mut offset = 0
  for field in fields {
    copy_bytes(buffer, offset, field)
    offset = offset + field.length() + 1
  }
  self.node_bytes(@protocol.COMPONENT_NATIVE_EXTENSION, Bytes::from_array(buffer[:]))
}

///| Bind a token for an extension-defined configuration field. The token belongs to this frame.
/// Extension packages must encode this value in their own documented configuration format.
pub fn Frame::bind_extension_event(self : Frame,
  handler : (EventContext, ControlEvent) -> Unit) -> UInt64 {
  if !self.writable() || self.session.next_event > 0x7fffffffUL {
    self.fail("Extension event tokens exhausted or frame finished")
    return 0UL
  }
  let token = 0x0000000180000000UL | self.session.next_event
  self.session.next_event = self.session.next_event + 1UL
  self.events.set(token, { callback: fn(ctx, event) {
    match event {
      Control(control) if control.kind >= 0x8000 => handler(ctx, control)
      _ => ctx.fail("Expected extension event (kind high bit set)")
    }
  } })
  token
}

///|
pub fn Window::supports_extension(self : Window, extension : Extension) -> Result[Bool, UiError] {
  match self.live() {
    Err(error) => Err(error)
    Ok((host, _)) => {
      let id = encode_text(extension.id)
      let status = @ffi.supports_extension(host, id, id.length(), extension.version, extension.schema_hash)
      match status {
        0 => Ok(true)
        -81 => Ok(false) // Provider not installed; a schema mismatch is not an absence.
        _ => Err(ui_error(status, "Extension capability query failed or schema mismatched"))
      }
    }
  }
}

///|
pub fn Window::extension_command(self : Window, extension : Extension, key : String,
  command : Int, payload : Bytes, revision? : UInt64 = 0UL, flags? : Int = 0) -> Result[Unit, UiError] {
  let key_bytes = encode_text(key)
  if !valid_key(key_bytes) { return Err(ui_error(@ffi.ERR_ARGUMENT, "Invalid extension resource key")) }
  match self.live() {
    Err(error) => Err(error)
    Ok((host, _)) => {
      let id = encode_text(extension.id)
      let component = encode_text(extension.component)
      status_result(@ffi.extension_command(host, self.id, 1U, command, flags,
        extension.version, extension.schema_hash, revision, id, id.length(), component, component.length(),
        key_bytes, key_bytes.length(), payload, payload.length()), "extension command")
    }
  }
}
